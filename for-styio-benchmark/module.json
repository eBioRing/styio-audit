{
  "schema_version": 1,
  "module_id": "for-styio-benchmark",
  "module_type": "project",
  "description": "Repository module for Styio benchmark harnesses, reports, probes, and regression artifacts.",
  "last_updated": "2026-06-29",
  "project_ids": [
    "styio-benchmark",
    "benchmark"
  ],
  "audit_profile": "benchmark-basic",
  "technology_stack": [
    "Python benchmark harnesses",
    "Native C++ benchmark probes",
    "Markdown and JSON benchmark reports"
  ],
  "internal_components": [
    "async_runtime_benchmarks",
    "native_cpp_benchmarks",
    "styio_probe_suite",
    "benchmark_reports"
  ],
  "open_source_components": [
    "Python standard library",
    "pytest-compatible test harnesses",
    "CSV/JSON report artifacts"
  ],
  "dependency_manifests": [
    "pyproject.toml"
  ],
  "ci_gate_contract": {
    "test_gates": {
      "smoke": "test / smoke",
      "golden_standard": "test / golden-standard"
    },
    "submit_readiness": "A styio-benchmark version is submittable when `test / smoke` and `test / golden-standard` both pass.",
    "golden_standard_suite": {
      "manifest": "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md",
      "required_files": [
        "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md"
      ],
      "required_markers": {
        "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md": [
          "test / smoke",
          "test / golden-standard",
          "submit readiness"
        ]
      }
    },
    "industry_gate_groups": {
      "benchmark / measurement-integrity": {
        "covered_by": "test / golden-standard",
        "industry_references": [
          "LLVM Testing Infrastructure Guide: whole-program output and timing comparison",
          "OpenSSF Scorecard: CI tests before merge"
        ],
        "required_markers": [
          "black-box",
          "pytest",
          "byte-compile",
          "explicit skip",
          "performance baseline"
        ]
      }
    },
    "local_gate_profile": {
      "profile_id": "styio-benchmark-async-blackbox-profile",
      "manifest": "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md",
      "covered_by": "test / golden-standard",
      "required_markers": [
        "repo-owned adaptation",
        "async runtime black-box",
        "pytest",
        "explicit skip"
      ]
    }
  },
  "resource_classes": [
    {
      "id": "benchmark_evidence",
      "owner": "Benchmarking",
      "description": "Owns benchmark execution scripts, performance reports, and regression evidence.",
      "scope_globs": [
        "async-runtime/**",
        "native-cpp/**",
        "styio-probes/**",
        "tools/**",
        "docs/**",
        "reports/**",
        "pyproject.toml"
      ],
      "copying_policy": "Benchmark reports may summarize measurements but must not copy private runtime data or production traces.",
      "concurrency_policy": "Benchmark updates must keep inputs, tools, and generated reports associated with a reproducible run.",
      "nullability_policy": "Missing benchmark scripts or report metadata make performance evidence unauditable.",
      "cleanup_policy": "Transient benchmark caches and local profiler output must stay untracked unless intentionally archived as reports.",
      "state_machine": {
        "source": "Benchmark evidence lifecycle.",
        "states": [
          "planned",
          "measured",
          "archived"
        ],
        "transitions": [
          {
            "from": "planned",
            "to": "measured",
            "on": "run benchmark harness"
          },
          {
            "from": "measured",
            "to": "archived",
            "on": "record report metadata and summary"
          }
        ],
        "invalid_operations": [
          "publish benchmark numbers without harness metadata",
          "commit private runtime traces"
        ]
      },
      "required_tests": [
        "benchmark harness smoke tests and report schema checks"
      ],
      "required_gates": [
        "styio-audit common gate",
        "benchmark reproducibility gate"
      ],
      "audit_risks": [
        "non-reproducible performance evidence",
        "private trace leakage",
        "stale benchmark baselines"
      ]
    }
  ]
}
