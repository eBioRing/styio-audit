{
  "schema_version": 1,
  "module_id": "for-styio-dev-doc",
  "module_type": "project",
  "description": "Repository module for Styio developer documentation, ecosystem manuals, and bilingual runbooks.",
  "last_updated": "2026-06-29",
  "project_ids": [
    "styio-dev-doc",
    "dev-doc"
  ],
  "audit_profile": "documentation-basic",
  "technology_stack": [
    "Markdown developer manuals",
    "GitBook-style English and Chinese documentation",
    "Python documentation checks"
  ],
  "internal_components": [
    "english_developer_manual",
    "chinese_developer_manual",
    "documentation_check_scripts",
    "ecosystem_repository_matrix"
  ],
  "open_source_components": [
    "Markdown",
    "Python standard library",
    "GitBook conventions"
  ],
  "dependency_manifests": [
    "README.md",
    "en/SUMMARY.md",
    "zh/SUMMARY.md"
  ],
  "ci_gate_contract": {
    "test_gates": {
      "smoke": "test / smoke",
      "golden_standard": "test / golden-standard"
    },
    "submit_readiness": "A styio-dev-doc version is submittable when `test / smoke` and `test / golden-standard` both pass.",
    "golden_standard_suite": {
      "manifest": "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md",
      "required_files": [
        "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md"
      ],
      "required_markers": {
        "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md": [
          "test / smoke",
          "test / golden-standard",
          "submit readiness"
        ]
      }
    },
    "industry_gate_groups": {
      "docs / maintainer-quality": {
        "covered_by": "test / golden-standard",
        "industry_references": [
          "GitHub rulesets: branch and push rules for repository controls",
          "OpenSSF Scorecard: CI tests and code review before merge"
        ],
        "required_markers": [
          "gitbook validation",
          "browser smoke",
          "English",
          "Chinese",
          "structure checker"
        ]
      }
    },
    "local_gate_profile": {
      "profile_id": "styio-dev-doc-gitbook-browser-profile",
      "manifest": "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md",
      "covered_by": "test / golden-standard",
      "required_markers": [
        "repo-owned adaptation",
        "GitBook",
        "browser smoke",
        "English",
        "Chinese"
      ]
    }
  },
  "resource_classes": [
    {
      "id": "developer_manual_surface",
      "owner": "Developer Documentation",
      "description": "Owns developer-facing manuals, runbooks, standards, and documentation validation scripts.",
      "scope_globs": [
        "README.md",
        "en/**",
        "zh/**",
        "scripts/**",
        ".github/workflows/**"
      ],
      "copying_policy": "Developer docs may reference public source and APIs but must not copy private credentials, deployment inventory, or unpublished operations material.",
      "concurrency_policy": "Bilingual and ecosystem matrix updates should remain consistent when shared repository contracts change.",
      "nullability_policy": "Missing summaries, standards, or validation scripts make documentation coverage incomplete.",
      "cleanup_policy": "Generated documentation build artifacts must stay under ignored artifact directories.",
      "state_machine": {
        "source": "Developer documentation lifecycle.",
        "states": [
          "draft",
          "validated",
          "published"
        ],
        "transitions": [
          {
            "from": "draft",
            "to": "validated",
            "on": "run documentation checks"
          },
          {
            "from": "validated",
            "to": "published",
            "on": "merge approved documentation"
          }
        ],
        "invalid_operations": [
          "publish private operations material",
          "skip documentation validation"
        ]
      },
      "required_tests": [
        "scripts/verify.sh or equivalent documentation validation"
      ],
      "required_gates": [
        "styio-audit common gate",
        "gitbook documentation gate"
      ],
      "audit_risks": [
        "stale developer workflow",
        "bilingual drift",
        "private infrastructure leakage"
      ]
    }
  ]
}
