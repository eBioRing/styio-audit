{
  "schema_version": 1,
  "module_id": "for-styio-book",
  "module_type": "project",
  "description": "Repository module for the Styio language book and bilingual learning content.",
  "last_updated": "2026-06-29",
  "project_ids": [
    "styio-book",
    "book"
  ],
  "audit_profile": "documentation-basic",
  "technology_stack": [
    "Markdown book content",
    "GitBook-style summary trees",
    "Bilingual Styio language documentation"
  ],
  "internal_components": [
    "english_book",
    "chinese_book",
    "language_examples",
    "navigation_summaries"
  ],
  "open_source_components": [
    "Markdown",
    "GitBook content conventions"
  ],
  "dependency_manifests": [
    "README.md",
    "en/SUMMARY.md",
    "cn/SUMMARY.md"
  ],
  "ci_gate_contract": {
    "test_gates": {
      "smoke": "test / smoke",
      "golden_standard": "test / golden-standard"
    },
    "submit_readiness": "A styio-book version is submittable when `test / smoke` and `test / golden-standard` both pass.",
    "golden_standard_suite": {
      "manifest": "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md",
      "required_files": [
        "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md"
      ],
      "required_markers": {
        "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md": [
          "test / smoke",
          "test / golden-standard",
          "submit readiness"
        ]
      }
    },
    "industry_gate_groups": {
      "docs / publication-quality": {
        "covered_by": "test / golden-standard",
        "industry_references": [
          "GitHub rulesets: push rules for path, extension, and file-size control",
          "OpenSSF Scorecard: binary artifacts and CI tests before merge"
        ],
        "required_markers": [
          "language summary",
          "markdown reachability",
          "no root summary",
          "line endings"
        ]
      }
    },
    "local_gate_profile": {
      "profile_id": "styio-book-bilingual-summary-profile",
      "manifest": "docs/specs/GOLDEN-STANDARD-TEST-SUITE.md",
      "covered_by": "test / golden-standard",
      "required_markers": [
        "repo-owned adaptation",
        "English summary",
        "Chinese summary",
        "Markdown reachability",
        "no root summary"
      ]
    }
  },
  "resource_classes": [
    {
      "id": "language_book_content",
      "owner": "Documentation",
      "description": "Owns public Styio language book content and example explanations.",
      "scope_globs": [
        "README.md",
        "en/**",
        "cn/**"
      ],
      "copying_policy": "Book content must preserve license notices and avoid copying private design notes or production service material.",
      "concurrency_policy": "Cross-language content changes should keep English and Chinese navigation coherent when both surfaces are affected.",
      "nullability_policy": "Missing README or summary files make the book structure unauditable.",
      "cleanup_policy": "Generated book outputs and local preview artifacts must stay outside tracked source.",
      "state_machine": {
        "source": "Book content lifecycle.",
        "states": [
          "draft",
          "reviewed",
          "published"
        ],
        "transitions": [
          {
            "from": "draft",
            "to": "reviewed",
            "on": "technical and editorial review"
          },
          {
            "from": "reviewed",
            "to": "published",
            "on": "merge to protected branch"
          }
        ],
        "invalid_operations": [
          "publish private service endpoints",
          "remove navigation coverage for active chapters"
        ]
      },
      "required_tests": [
        "book link and summary consistency checks"
      ],
      "required_gates": [
        "styio-audit common gate",
        "documentation build gate"
      ],
      "audit_risks": [
        "stale language specification",
        "broken navigation",
        "private operations leakage in examples"
      ]
    }
  ]
}
